[Unit]
Description=Hesabix RQ Worker (Background Jobs)
Documentation=https://hesabix.com/docs/rq-worker
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hesabix/app/hesabixAPI

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/hesabix/app/hesabixAPI"
Environment="PATH=/opt/hesabix/app/hesabixAPI/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# اجرای Worker
ExecStart=/opt/hesabix/app/hesabixAPI/.venv/bin/python /opt/hesabix/app/hesabixAPI/rq_worker.py

# خروج عادی (مثلاً Redis غیرفعال) نباید باعث ری‌استارت شود
Restart=on-failure
RestartSec=10
StartLimitInterval=5min
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hesabix-rq-worker

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
