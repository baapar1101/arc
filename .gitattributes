* text=auto

# Cross-platform source and configuration files
*.py text eol=lf
*.dart text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows-native scripts and project files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binary artifacts
*.cab binary
*.dll binary
*.exe binary
*.ico binary
*.jpg binary
*.jpeg binary
*.msi binary
*.pdf binary
*.png binary
*.pyc binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
