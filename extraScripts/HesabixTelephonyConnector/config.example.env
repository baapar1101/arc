HESABIX_API_URL=https://hsxn.hesabix.ir
HESABIX_BUSINESS_ID=1
HESABIX_PBX_ID=1
HESABIX_CONNECTOR_TOKEN=hsx_tel_replace_me
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=hesabix
AMI_SECRET=change_me

# Softphone Media Relay
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
MEDIA_TUNNEL_ENABLED=1
# فقط اگر گواهی TLS داخلی/self-signed دارید:
# HESABIX_MEDIA_INSECURE_SSL=1
# اگر WSS از پشت ArvanCloud با 403 می‌خورد، URL مستقیم origin (بدون CDN) را بگذارید:
# HESABIX_MEDIA_WS_URL=wss://YOUR_ORIGIN_HOST/ws/telephony/connector/media
# اختیاری: Origin سفارشی (پیش‌فرض Origin ارسال نمی‌شود)
# HESABIX_MEDIA_WS_ORIGIN=https://hsxn.hesabix.ir
