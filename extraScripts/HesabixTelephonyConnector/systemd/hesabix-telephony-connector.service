[Unit]
Description=Hesabix Telephony Connector
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/HesabixTelephonyConnector
EnvironmentFile=/opt/HesabixTelephonyConnector/.env
ExecStart=/usr/bin/python3 /opt/HesabixTelephonyConnector/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
