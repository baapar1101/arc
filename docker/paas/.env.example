# Forgejo Container Registry namespace for this project.
IMAGE_NAMESPACE=source.hesabix.ir/hesabix
IMAGE_TAG=0.1.0
API_IMAGE=${IMAGE_NAMESPACE}/hesabix-backend:${IMAGE_TAG}
DATABASE_IMAGE=${IMAGE_NAMESPACE}/hesabix-postgres-seeded:${IMAGE_TAG}

API_PORT=8000
APP_VERSION=0.1.0
DB_USER=hesabix
DB_NAME=hesabix
DB_PASSWORD=replace-with-a-long-random-password
CAPTCHA_SECRET=replace-with-a-long-random-secret
SHARE_LINK_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-secret
WALLET_WEBHOOK_SECRET=replace-with-a-long-random-secret
REDIS_ENABLED=false
